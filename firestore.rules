rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSeller() {
      return signedIn()
        && 'seller' in currentUser().roles;
    }

    function isCustomer() {
      return signedIn() && 'customer' in currentUser().roles;
    }

    function ownsStore(storeId) {
      return isSeller()
        && get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid;
    }

    function validPaymentSettings(settings) {
      return settings is map
        && settings.upiId is string
        && settings.upiDisplayName is string
        && settings.upiEnabled is bool
        && settings.codEnabled is bool
        && (settings.upiEnabled || settings.codEnabled)
        && (!settings.upiEnabled || (
          settings.upiId.matches('^[a-zA-Z0-9._-]{2,256}@[a-zA-Z][a-zA-Z0-9.-]{1,63}$')
          && settings.upiDisplayName.size() > 0
        ));
    }

    match /users/{uid} {
      allow create: if ownsUser(uid)
        && request.resource.data.roles.size() == 1
        && request.resource.data.activeRole in request.resource.data.roles
        && request.resource.data.roles[0] in ['customer', 'seller']
        && (
          request.resource.data.roles[0] == 'customer'
          || request.resource.data.sellerStatus in ['approved', 'pending']
        );
      allow read: if ownsUser(uid);
      allow update: if ownsUser(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['activeRole', 'name', 'mobile', 'updatedAt'])
        && request.resource.data.activeRole in resource.data.roles;
      allow delete: if false;
    }

    match /stores/{storeId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status in ['approved', 'pending'];
      allow update: if isSeller()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'owner', 'phone', 'gstin', 'businessHours', 'deliveryRadiusKm',
          'address', 'paymentSettings', 'updatedAt'
        ])
        && (!request.resource.data.keys().hasAny(['paymentSettings']) || validPaymentSettings(request.resource.data.paymentSettings));
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isSeller()
        && request.resource.data.sellerId == request.auth.uid;
      allow update: if (
          isSeller()
          && resource.data.sellerId == request.auth.uid
        ) || (
          isCustomer()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['stock', 'status', 'lastOrderId', 'updatedAt'])
          && request.resource.data.lastOrderId is string
          && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastOrderId)).data.customerId == request.auth.uid
          && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastOrderId)).data.storeId == resource.data.storeId
          && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastOrderId)).data.itemQuantities[productId] is int
          && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastOrderId)).data.itemQuantities[productId] > 0
          && request.resource.data.stock == resource.data.stock - getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastOrderId)).data.itemQuantities[productId]
          && request.resource.data.stock >= 0
          && (
            (request.resource.data.stock == 0 && request.resource.data.status == 'out-of-stock')
            || (request.resource.data.stock > 0 && request.resource.data.status == 'published')
          )
        );
      allow delete: if isSeller()
        && resource.data.sellerId == request.auth.uid;
    }

    match /orders/{orderId} {
      allow create: if isCustomer()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.storeId is string
        && request.resource.data.sellerId is string
        && request.resource.data.subtotal is number
        && request.resource.data.deliveryCharge is number
        && request.resource.data.discount is number
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount == request.resource.data.subtotal + request.resource.data.deliveryCharge - request.resource.data.discount
        && request.resource.data.total == request.resource.data.totalAmount
        && request.resource.data.totalAmount > 0
        && request.resource.data.currency == 'INR'
        && request.resource.data.paymentMethod in ['upi', 'cod']
        && (
          (
            request.resource.data.paymentMethod == 'upi'
            && request.resource.data.paymentStatus == 'PENDING'
            && request.resource.data.orderStatus == 'PAYMENT_PENDING'
            && request.resource.data.sellerUpiIdSnapshot is string
            && request.resource.data.sellerUpiNameSnapshot is string
            && request.resource.data.expiresAt is timestamp
            && request.resource.data.expiresAt > request.time
            && get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.ownerId == request.resource.data.sellerId
            && validPaymentSettings(get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.paymentSettings)
            && get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.paymentSettings.upiEnabled == true
            && request.resource.data.sellerUpiIdSnapshot == get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.paymentSettings.upiId
            && request.resource.data.sellerUpiNameSnapshot == get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.paymentSettings.upiDisplayName
          )
          || (
            request.resource.data.paymentMethod == 'cod'
            && request.resource.data.paymentStatus == 'PAYMENT_DUE'
            && request.resource.data.orderStatus == 'PLACED'
            && (
              (
                get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.ownerId == request.resource.data.sellerId
                && get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.paymentSettings.codEnabled == true
              )
              || (
                request.resource.data.sellerId == ''
                && request.resource.data.storeId in ['autohub-mumbai', 'prime-spares', 'motorworks']
              )
            )
          )
        )
        && !request.resource.data.keys().hasAny(['paymentVerifiedBy', 'paymentVerifiedAt', 'upiTransactionReference']);
      allow read: if signedIn() && (
        resource.data.customerId == request.auth.uid
        || ownsStore(resource.data.storeId)
      );
      allow update: if (
        isCustomer()
        && resource.data.customerId == request.auth.uid
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.storeId == resource.data.storeId
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.totalAmount == resource.data.totalAmount
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'upiTransactionReference', 'paymentReference', 'paymentStatus', 'orderStatus',
          'paymentSubmittedAt', 'updatedAt'
        ])
        && request.resource.data.upiTransactionReference is string
        && request.resource.data.upiTransactionReference.matches('^[0-9]{12,35}$')
        && request.resource.data.paymentReference == request.resource.data.upiTransactionReference
        && resource.data.paymentMethod == 'upi'
        && resource.data.paymentStatus in ['PENDING', 'VERIFICATION_FAILED']
        && request.resource.data.paymentStatus == 'PAYMENT_SUBMITTED'
        && request.resource.data.orderStatus == 'PAYMENT_VERIFICATION_PENDING'
        && request.time < resource.data.expiresAt
        && getAfter(/databases/$(database)/documents/paymentReferences/$(request.resource.data.upiTransactionReference)).data.orderId == orderId
        && getAfter(/databases/$(database)/documents/paymentReferences/$(request.resource.data.upiTransactionReference)).data.customerId == request.auth.uid
      ) || (
        isCustomer()
        && resource.data.customerId == request.auth.uid
        && resource.data.paymentMethod == 'upi'
        && resource.data.paymentStatus == 'PENDING'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus', 'orderStatus', 'updatedAt'])
        && (
          (request.resource.data.paymentStatus == 'PAYMENT_CANCELLED' && request.resource.data.orderStatus == 'PAYMENT_CANCELLED')
          || (request.resource.data.paymentStatus == 'PAYMENT_EXPIRED' && request.resource.data.orderStatus == 'PAYMENT_EXPIRED' && request.time >= resource.data.expiresAt)
        )
      ) || (
        ownsStore(resource.data.storeId)
        && resource.data.paymentMethod == 'upi'
        && resource.data.paymentStatus == 'PAYMENT_SUBMITTED'
        && request.resource.data.paymentStatus == 'PAID'
        && request.resource.data.orderStatus == 'PLACED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'paymentStatus', 'orderStatus', 'status', 'stage', 'eta',
          'paymentVerifiedBy', 'paymentVerifiedAt', 'updatedAt'
        ])
        && request.resource.data.paymentVerifiedBy == request.auth.uid
        && request.resource.data.paymentVerifiedAt is timestamp
        && getAfter(/databases/$(database)/documents/paymentReferences/$(resource.data.upiTransactionReference)).data.orderId == orderId
        && getAfter(/databases/$(database)/documents/paymentReferences/$(resource.data.upiTransactionReference)).data.status == 'PAID'
      ) || (
        ownsStore(resource.data.storeId)
        && resource.data.paymentStatus == 'PAYMENT_SUBMITTED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus', 'orderStatus', 'updatedAt'])
        && request.resource.data.paymentStatus == 'VERIFICATION_FAILED'
        && request.resource.data.orderStatus == 'PAYMENT_VERIFICATION_PENDING'
      ) || (
        ownsStore(resource.data.storeId)
        && (!resource.data.keys().hasAny(['orderStatus']) || resource.data.orderStatus == 'PLACED')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'stage', 'eta', 'updatedAt'])
      );
      allow delete: if false;
    }

    match /paymentReferences/{referenceId} {
      allow create: if isCustomer()
        && request.resource.data.reference == referenceId
        && referenceId.matches('^[0-9]{12,35}$')
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'PAYMENT_SUBMITTED'
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.storeId == request.resource.data.storeId
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.upiTransactionReference == referenceId;
      allow read: if signedIn() && (
        resource.data.customerId == request.auth.uid
        || ownsStore(resource.data.storeId)
      );
      allow update: if (
        isCustomer()
        && resource.data.customerId == request.auth.uid
        && resource.data.status == 'VERIFICATION_FAILED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'PAYMENT_SUBMITTED'
        && getAfter(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.customerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.upiTransactionReference == referenceId
        && getAfter(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.paymentStatus == 'PAYMENT_SUBMITTED'
      ) || (
        ownsStore(resource.data.storeId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'paymentVerifiedBy', 'paymentVerifiedAt', 'updatedAt'
        ])
        && request.resource.data.status in ['PAID', 'VERIFICATION_FAILED']
        && (
          request.resource.data.status == 'VERIFICATION_FAILED'
          || (
            request.resource.data.paymentVerifiedBy == request.auth.uid
            && request.resource.data.paymentVerifiedAt is timestamp
            && getAfter(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.paymentStatus == 'PAID'
          )
        )
      );
      allow delete: if false;
    }

    match /tickets/{ticketId} {
      allow create: if isCustomer()
        && request.resource.data.keys().hasOnly([
          'id', 'orderId', 'storeId', 'storeName', 'customerId', 'customer',
          'issue', 'message', 'createdAt', 'updatedAt', 'priority', 'status',
          'orderedProduct'
        ])
        && request.resource.data.id == ticketId
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.orderId is string
        && request.resource.data.storeId is string
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerId == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.storeId == request.resource.data.storeId
        && request.resource.data.issue is string
        && request.resource.data.issue.size() > 0
        && request.resource.data.issue.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 1000
        && request.resource.data.priority in ['Urgent', 'High', 'Normal']
        && request.resource.data.status == 'Open'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow read: if signedIn() && (
        resource.data.customerId == request.auth.uid
        || ownsStore(resource.data.storeId)
      );
      allow update: if ownsStore(resource.data.storeId)
        && resource.data.status == 'Open'
        && request.resource.data.status == 'Resolved'
        && request.resource.data.internalNote is string
        && request.resource.data.internalNote.size() <= 1000
        && request.resource.data.resolvedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'internalNote', 'resolvedAt', 'updatedAt']);
      allow delete: if false;
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isCustomer()
        && request.resource.data.keys().hasOnly([
          'id', 'orderId', 'storeId', 'storeName', 'customerId', 'customerName',
          'stars', 'comment', 'createdAt', 'verified'
        ])
        && request.resource.data.id == ratingId
        && request.resource.data.orderId == ratingId
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.storeId is string
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500
        && request.resource.data.verified == true
        && request.resource.data.createdAt is timestamp
        && get(/databases/$(database)/documents/orders/$(ratingId)).data.customerId == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(ratingId)).data.storeId == request.resource.data.storeId
        && get(/databases/$(database)/documents/orders/$(ratingId)).data.stage == 'Delivered';
      allow update, delete: if false;
    }

    match /vehicleMakes/{makeId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /vehicleModels/{vehicleModelId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /vehicleVariants/{variantId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create: if isSeller()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.storeId in currentUser().storeIds
        && ownsStore(request.resource.data.storeId)
        && request.resource.data.type in ['arrival', 'seller']
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 5
        && request.resource.data.text.size() <= 100
        && request.resource.data.active is bool;
      allow update: if isSeller()
        && resource.data.sellerId == request.auth.uid
        && ownsStore(resource.data.storeId)
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.storeId == resource.data.storeId
        && request.resource.data.type in ['arrival', 'seller']
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 5
        && request.resource.data.text.size() <= 100
        && request.resource.data.active is bool;
      allow delete: if isSeller()
        && resource.data.sellerId == request.auth.uid
        && ownsStore(resource.data.storeId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
