# Replace the built-in demo repository with real provider credentials here later.
NEXT_PUBLIC_API_MODE=demo
# Reuses the same Google Places integration pattern as DiagHub.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# CarVector vehicle search. Keep this server-only; never expose it as NEXT_PUBLIC_*.
CARVECTOR_API_KEY=

# Product-image storage. Keep API key and secret server-only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional signed upload preset with Cloudinary-side format and file-size limits.
CLOUDINARY_UPLOAD_PRESET=
