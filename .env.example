# Replace the built-in demo repository with real provider credentials here later.
NEXT_PUBLIC_API_MODE=demo

# Public HTTPS base used only by the packaged Capacitor app for the existing PartX APIs.
NEXT_PUBLIC_PARTX_API_BASE_URL=https://motopart-web.vercel.app

# Reuses the same Google Places integration pattern as DiagHub.
# Restrict the browser key to the PartX web and Capacitor origins.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Public Firebase Cloud Messaging Web Push certificate. Safe to expose in the browser.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# CarVector vehicle search. Keep this server-only; never expose it as NEXT_PUBLIC_*.
CARVECTOR_API_KEY=

# Product-image storage. Keep API key and secret server-only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional signed upload preset with Cloudinary-side format and file-size limits.
CLOUDINARY_UPLOAD_PRESET=
