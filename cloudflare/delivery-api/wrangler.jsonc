{
  "name": "partx-delivery-api",
  "main": "worker.js",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "vars": {
    "FIREBASE_PROJECT_ID": "partx-production",
    "ALLOWED_ORIGINS": "https://motopart-web.vercel.app,https://localhost"
  },
  "durable_objects": {
    "bindings": [{ "name": "PARTX_ADMIN_ACTIVITY", "class_name": "PartXAdminActivity" }]
  },
  "ratelimits": [
    { "name": "PARTX_GUEST_RATE_LIMIT", "namespace_id": "137514", "simple": { "limit": 30, "period": 60 } }
  ],
  "migrations": [{ "tag": "partx-admin-activity-v1", "new_sqlite_classes": ["PartXAdminActivity"] }],
  "observability": { "enabled": true }
}
